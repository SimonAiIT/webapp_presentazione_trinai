DirectoryIndex gate.php

<IfModule mod_authz_core.c>
  <FilesMatch "^\.(gate_|htaccess|ftpquota|gitignore)">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
  <FilesMatch "^\.(gate_|htaccess|ftpquota|gitignore)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.gate_ - [F,L]
  RewriteRule ^\.(htaccess|ftpquota|gitignore) - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^gate\.php$ - [L]
  RewriteRule ^(.*)$ gate.php [L,QSA]
</IfModule>
